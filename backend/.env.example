# Google Cloud — production uses Vertex AI via ADC, not API keys
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
# Gemini 3 models are served from the global Vertex AI endpoint
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_API_KEY is only needed for local test scripts that bypass Vertex AI.
# Production code uses genai.Client(vertexai=True) with Application Default Credentials.
# Run `gcloud auth application-default login` for local Vertex AI access.

# MongoDB
MONGODB_CONNECTION_STRING=mongodb+srv://...
MCP_SERVER_URL=http://localhost:8081/mcp
ENABLE_MCP_MEMORY_TOOLS=1

# Voyage AI (MongoDB-provided, compliance OK)
VOYAGE_API_KEY=<voyage-key>

# Firebase — production uses ADC (no credential file needed on Cloud Run)
FIREBASE_PROJECT_ID=<your-firebase-project-id>
# Local dev only: path to service account key (excluded from Docker via .dockerignore)
FIREBASE_CREDENTIALS_PATH=./firebase-admin-key.json

# Similarity threshold (default for new users; per-user overrides stored in DB)
SIMILARITY_THRESHOLD=0.55

# LLM intent layer (/api/ranking/intent); defaults to gemini-3-flash-preview
# INTENT_MODEL=gemini-3-flash-preview

# Cloud Storage
GCS_BUCKET=<your-gcs-bucket>

# Pipeline concurrency (default: 2 simultaneous fragment ingest jobs)
# MAX_CONCURRENT_PIPELINES=2

# CORS — comma-separated origins allowed by the API
# CORS_ORIGINS=http://localhost:3000,https://pocketproducer.vercel.app

# CLAP audio embeddings (optional; enables audio-cosine ranker)
# POCKET_ENABLE_CLAP=1

# Gemini model overrides (all default to gemini-3-flash-preview)
# TAGGING_MODEL=gemini-3-flash-preview
# TAGGING_MODEL_AUDIO=gemini-3-flash-preview
# PRODUCER_MODEL=gemini-3-flash-preview
# MEMORY_MODEL=gemini-3-flash-preview
