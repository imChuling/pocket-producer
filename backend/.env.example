# Google Cloud
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_API_KEY=<from-AI-Studio>

# MongoDB
MONGODB_CONNECTION_STRING=mongodb+srv://...
MCP_SERVER_URL=http://localhost:8081/mcp

# Voyage AI (MongoDB-provided, compliance OK)
VOYAGE_API_KEY=<voyage-key>

# Firebase
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_CREDENTIALS_PATH=./firebase-admin-key.json

# Cloud Storage
GCS_BUCKET=<your-gcs-bucket>

# Audio Service (Plan B for librosa)
AUDIO_SERVICE_URL=http://localhost:8082
